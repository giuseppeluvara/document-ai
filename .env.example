# Copia in .env. Non committare credenziali, documenti o risultati.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_SECRET_KEY=  # se assente viene generata una chiave locale persistente
# DOCUMENT_AI_DATA_DIR=/percorso/privato/document-ai-data
DOCUMENT_AI_ENDPOINT=http://127.0.0.1:8081/v1
DOCUMENT_AI_MODEL=local
DOCUMENT_AI_TIMEOUT=180
DOCUMENT_AI_CONTEXT_CHARS=6500
DOCUMENT_AI_MAX_TOKENS=1200
DOCUMENT_AI_OCR_LANGUAGE=ita+eng
DOCUMENT_AI_MAX_PAGES=50
DOCUMENT_AI_MAX_CHARS=250000
DOCUMENT_AI_MAX_UPLOAD_MB=20
